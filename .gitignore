# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local installer files
image-library/*.msi
image-library/*.exe

# Local development logs
*.log
.devserver.*

# Playwright testing artifacts
/.playwright-mcp/
/test-results/
/playwright-report/

# Local screenshots and design review captures
/current-desktop-full.png
/home-1440-full.png
/home-390-full.png
/nav-closed-hero-1440.png
/nav-open-1440.png
/nav-open-390.png
/ref-blog.png
