# Form endpoint for booking requests and contact enquiries (Formspree, Web3Forms, etc.)
# Must accept JSON POST { kind: "booking-request" | "general-enquiry", ... } and return 2xx.
NEXT_PUBLIC_BOOKING_ENDPOINT=

# Newsletter / email marketing integration (Mailchimp, ConvertKit, Brevo, etc.)
# Must accept email subscription POST from /packages newsletter form.
# Example: NEXT_PUBLIC_MAILCHIMP_LIST_ID= and NEXT_PUBLIC_MAILCHIMP_SERVER= or backend endpoint.
# Not currently configured — newsletter uses mailto fallback until integration is added.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
